}

@article{francaForestLandscapePlanning2022,
  title = {Forest Landscape Planning and Management: {{A}} State-of-the-Art Review},
  shorttitle = {Forest Landscape Planning and Management},
  author = {Fran{\c c}a, Luciano Cavalcante de Jesus and J{\'u}nior, Fausto Weimar Acerbi and {Jarochinski e Silva}, Carolina Souza and Monti, C{\'a}ssio Augusto Ussi and Ferreira, Thais Cunha and Santana, Cesar Junio de Oliveira and Gomide, Lucas Rezende},
  year = {2022},
