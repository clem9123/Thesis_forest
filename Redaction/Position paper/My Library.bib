}

@article{rojoEvaluatingManagementRegimes2014,
  title = {Evaluating Management Regimes for {{European}} Beech Forests Using Dynamic Programming},
  author = {Rojo, Juan Torres and Von Gadow, Klaus and Vilcko, Frantisek},
