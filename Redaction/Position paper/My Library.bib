@misc{shaninSynergiesTradeOffsMultiple2024,
  type = {{{SSRN Scholarly Paper}}},
  title = {Synergies and {{Trade-Offs}} between {{Multiple Forest Ecosystem Services}} for {{Forest Management Under Climate Change}}: {{Russian Case-Studies}}},
  shorttitle = {Synergies and {{Trade-Offs}} between {{Multiple Forest Ecosystem Services}} for {{Forest Management Under Climate Change}}},
  author = {Shanin, Vladimir and Lukina, Natalia V. and Tebenkova, Darya N. and Chumachenko, Sergey and Kolycheva, Anna and Frolov, Pavel and Chertov, Oleg and Khanina, Larisa and Bobrovsky, Maxim and Kiseleva, Vera and Kondratyev, Sergey and Shmakova, Marina},
  year = {2024},
  month = aug,
  number = {4940921},
  address = {Rochester, NY},
  doi = {10.2139/ssrn.4940921},
  urldate = {2024-09-03},
  abstract = {The objective of this study is to develop a conceptual framework for a multi-criteria management decision-making system as a tool for sustainable forest management. The system is based on projections of various forest ecosystem services, such as timber production, non-timber forest product supply, ecosystem carbon sequestration, recreational capacity, water runoff and nutrient removal. An integrated software platform was developed and used to predict the provision of a range of forest ecosystem services in several case studies located in different climatic conditions, from the middle taiga to the mixed forest zones of the European part of Russia. To take into account societal and economic demands, policy scenarios were developed as a basis for forest management planning, representing different widely used management practices. The policy scenarios were based on the different valuation of ecosystem services depending on the focus of forest management policy. Climate change scenarios based on the RCP~4.5, RCP~6.0 and RCP~8.5 emission scenarios were also used. Synergies and trade-offs between forest ecosystem services were analysed using the Pearson correlation coefficient between their predicted values. An integral and easily calculable indicator was developed to assess the forest management scenarios based on multiple criteria, taking into account the interactions between different ecosystem services and their socio-economic values. The main output of the analysis was a multi-criteria ranking, which showed that sustainable forest management can be an efficient tool to increase the multifunctionality of forest ecosystems in terms of simultaneous provision of multiple ecosystem services compared to natural forest development.},
  langid = {english},
  annotation = {0 citations (Crossref/DOI) [2024-09-03]\\
Read\_Status: 7\_Skimmed\\
Read\_Status\_Date: 2024-11-18T09:26:41.318Z},
  file = {C:\Users\cdemontgolf\Zotero\storage\XDV5WYM8\Shanin et al. - 2024 - Synergies and Trade-Offs between Multiple Forest Ecosystem Services for Forest Management Under Clim.pdf}
}

@article{shavazipourMultiscenarioMultiobjectiveRobust2021,
  title = {Multi-Scenario Multi-Objective Robust Optimization under Deep Uncertainty: {{A}} Posteriori Approach},
  shorttitle = {Multi-Scenario Multi-Objective Robust Optimization under Deep Uncertainty},
  author = {Shavazipour, Babooshka and Kwakkel, Jan H. and Miettinen, Kaisa},
  year = {2021},
  month = oct,
  journal = {Environmental Modelling \& Software},
  volume = {144},
  pages = {105134},
  issn = {1364-8152},
  doi = {10.1016/j.envsoft.2021.105134},
  urldate = {2025-01-10},
  abstract = {This paper proposes a novel optimization approach for multi-scenario multi-objective robust decision making, as well as an alternative way for scenario discovery and identifying vulnerable scenarios even before any solution generation. To demonstrate and test the novel approach, we use the classic shallow lake problem. We compare the results obtained with the novel approach to those obtained with previously used approaches. We show that the novel approach guarantees the feasibility and robust efficiency of the produced solutions under all selected scenarios, while decreasing computation cost, addresses the scenario-dependency issues, and enables the decision-makers to explore the trade-off between optimality/feasibility in any selected scenario and robustness across a broader range of scenarios. We also find that the lake problem is ill-suited for reflecting trade-offs in robust performance over the set of scenarios and Pareto optimality in any specific scenario, highlighting the need for novel benchmark problems to properly evaluate novel approaches.},
  keywords = {Deep uncertainty,Multi-objective optimization,Reference points,Robust decision making scalarizing functions,Scenario planning},
  annotation = {Read\_Status: 7\_Skimmed\\
Read\_Status\_Date: 2025-01-13T08:48:06.603Z},
