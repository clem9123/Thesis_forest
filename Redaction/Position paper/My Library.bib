@article{amacherForestsEcosystemServices2014,
  title = {Forests and Ecosystem Services: {{Outlines}} for New Policy Options},
  shorttitle = {Forests and Ecosystem Services},
  author = {Amacher, Gregory S. and Ollikainen, Markku and Uusivuori, Jussi},
  year = {2014},
