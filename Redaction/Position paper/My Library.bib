}

@article{delaraMulticriteriaDynamicDecision2009,
  title = {Multi-Criteria Dynamic Decision under Uncertainty: {{A}} Stochastic Viability Analysis and an Application to Sustainable Fishery Management},
  shorttitle = {Multi-Criteria Dynamic Decision under Uncertainty},
  author = {De Lara, M. and Martinet, V.},
