@article{cummingAdvancingUnderstandingNatural2020,
  title = {Advancing Understanding of Natural Resource Governance: A Post-{{Ostrom}} Research Agenda},
  shorttitle = {Advancing Understanding of Natural Resource Governance},
  author = {Cumming, G. S. and Epstein, G. and Anderies, J. M. and Apetrei, C. I. and Baggio, J. and Bodin, {\"O}. and Chawla, S. and Clements, H. S. and Cox, M. and Egli, L. and Gurney, G. G. and Lubell, M. and Magliocca, N. and Morrison, T. H. and M{\"u}ller, B. and Seppelt, R. and Schl{\"u}ter, M. and Unnikrishnan, H. and {Villamayor-Tomas}, S. and Weible, C. M.},
