  shorttitle = {International {{Forest Governance}} and {{Policy}}},
  author = {Sotirov, Metodi and Pokorny, Benno and Kleinschmit, Daniela and Kanowski, Peter},
  year = {2020},
  month = aug,
  journal = {Sustainability},
  volume = {12},
