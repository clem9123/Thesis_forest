@article{eyvindsonMitigatingForestBiodiversity2018,
  title = {Mitigating Forest Biodiversity and Ecosystem Service Losses in the Era of Bio-Based Economy},
  author = {Eyvindson, Kyle and Repo, Anna and M{\"o}nkk{\"o}nen, Mikko},
  year = {2018},
  month = jul,
  journal = {Forest Policy and Economics},
  volume = {92},
  pages = {119--127},
  issn = {1389-9341},
  doi = {10.1016/j.forpol.2018.04.009},
  urldate = {2024-09-03},
  abstract = {Forests play a crucial role in the transition towards a bioeconomy by providing biomass to substitute for fossil-based materials and energy. However, a policy-policy conflict exists between the desire to increase the utilization of bio based renewable resources and the desire to protect and conserve biodiversity. Increasing forest harvest levels to meet the needs of the bioeconomy may conflict with biodiversity protection and ecosystem services provided by forests. Through an optimization framework, we examined trade-offs between increasing the extraction of timber resources, and the impacts on biodiversity and non-wood ecosystem services, and investigated possibilities to reconcile trade-off with changes in forest management in 17 landscapes in boreal forests. A diverse range of alternative forest management regimes were used. The alternatives varied from set aside to continuous cover forestry and a range of management options to reflect potential applications of the current management recommendations. These included adjustments to the number of thinning, the timing of final felling and the method of regeneration. Increasing forest harvest level to the maximum economically sustainable harvest had a negative effect on the habitat suitability index, bilberry yield, deadwood diversity and carbon storage. It resulted in a loss in variation among landscapes in their conservation capacity and the ability to provide ecosystem services. Multi-objective optimization results showed that combining different forest management regimes alleviated the negative effects of increasing harvest levels to biodiversity and non-wood ecosystem services. The results indicate that careful landscape level forest management planning is crucial to minimize the ecological costs of increasing harvest levels.},
  annotation = {127 citations (Crossref/DOI) [2024-09-03]\\
Read\_Status: 8\_Uncategorized\\
Read\_Status\_Date: 2024-11-18T09:27:14.571Z},
