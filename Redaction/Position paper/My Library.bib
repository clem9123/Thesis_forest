@article{cullottaForestPlanningEurope2015,
  title = {Forest Planning across {{Europe}}: The Spatial Scale, Tools, Andinter-Sectoral Integration in Land-Use Planning},
  shorttitle = {Forest Planning across {{Europe}}},
  author = {Cullotta, Sebastiano and Bon{\v c}ina, Andrej and {Carvalho-Ribeiro}, Sonia M. and Chauvin, Christophe and Farcy, Christine and Kurttila, Mikko and Maetzke, Federico G.},
  year = {2015},
